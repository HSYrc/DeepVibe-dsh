{
  "name": "deepvibe-dsh",
  "version": "0.5.12",
  "description": "DeepVibe-dsh — a live light-ring background for the DeepSeek Harness Web GUI, driven by the current session: ring rotation, token capture and beams follow the model call, with an immersive dock, approval card, real Platform balance/today spend, and a Settings page.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "background",
    "decoration",
    "canvas",
    "visualization"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "tools/**/*",
    "build.mjs",
    "README.md",
    "DESIGN-COMPLETED.md",
    "PATCH-immersion.md",
    "SCENE-FIELD.md",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
